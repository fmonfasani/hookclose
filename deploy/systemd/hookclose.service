# systemd unit: bring the HookClose stack up on boot and keep it up.
# Install:
#   sudo cp deploy/systemd/hookclose.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hookclose
[Unit]
Description=HookClose / AINE runtime (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/hookclose
# Compose itself restarts containers (restart: always); systemd owns the stack lifecycle.
ExecStart=/usr/bin/docker compose --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml up -d --build
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
