# =============================================================================
# HookClose / AINE — PRODUCTION environment template.
# Copy to deploy/.env.prod on the server and fill in real secrets.
# NEVER commit deploy/.env.prod (it is git-ignored).
# =============================================================================

HOOKCLOSE_ENV=prod
HOOKCLOSE_LOG_LEVEL=INFO
HOOKCLOSE_LOG_FORMAT=json

# --- PostgreSQL (internal only; not published to host in prod) ---------------
HOOKCLOSE_POSTGRES_HOST=postgres
HOOKCLOSE_POSTGRES_PORT=5432
HOOKCLOSE_POSTGRES_DB=hookclose
HOOKCLOSE_POSTGRES_USER=hookclose
HOOKCLOSE_POSTGRES_PASSWORD=CHANGE_ME_STRONG_SECRET

# --- Redis -------------------------------------------------------------------
HOOKCLOSE_REDIS_HOST=redis
HOOKCLOSE_REDIS_PORT=6379
HOOKCLOSE_REDIS_DB=0
HOOKCLOSE_REDIS_URL=redis://redis:6379/0

# --- Scheduler / Workflow engine / Worker ------------------------------------
HOOKCLOSE_SCHEDULER_HEARTBEAT_INTERVAL=5
HOOKCLOSE_SCHEDULER_POLL_INTERVAL=3
HOOKCLOSE_WORKFLOW_QUEUE=workflows:pending
HOOKCLOSE_OPENCODE_TASK_QUEUE=tasks:opencode

# --- Provider credentials (set the ones you use; others stay empty) ----------
# Wired by the composition root. Empty = that provider is not registered; the
# runtime falls back to the deterministic local model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Backups -----------------------------------------------------------------
HOOKCLOSE_BACKUP_DIR=/opt/hookclose/backups
HOOKCLOSE_BACKUP_RETENTION_DAYS=14
